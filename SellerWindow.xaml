<Window x:Class="FlowerShopWPF.SellerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мир цветов" 
        Height="600" Width="900"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="CanResize"
        Loaded="Window_Loaded">
    <Grid Background="#FFF5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#4CAF50" Padding="20,0">
            <Grid>
                <TextBlock Text="Панель Сотрудника" FontSize="24" 
                           FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="txtWelcome" FontSize="14" Foreground="White" 
                               VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Content="Выход" Width="80" Height="35" 
                            Background="#D32F2F" Foreground="White" BorderThickness="0" 
                            Cursor="Hand" Click="btnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основное содержимое -->
        <TabControl Grid.Row="1" Margin="10">
            <!-- Вкладка: Управление товарами -->
            <TabItem Header="Управление товарами" FontSize="14">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Кнопки управления товарами -->
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                        <Button Content="➕ Добавить товар" Width="140" Height="35" Margin="0,0,10,0"
                                Background="#4CAF50" Foreground="White" BorderThickness="0" 
                                Cursor="Hand" Click="btnAddProduct_Click"/>
                        <Button Content="🗑 Удалить товар" Width="140" Height="35"
                                Background="#F44336" Foreground="White" BorderThickness="0" 
                                Cursor="Hand" Click="btnDeleteProduct_Click"/>
                        <Button Content="🔄 Обновить" Width="120" Height="35" Margin="10,0,0,0"
                                Background="#2196F3" Foreground="White" BorderThickness="0" 
                                Cursor="Hand" Click="btnRefreshProducts_Click"/>
                    </StackPanel>

                    <!-- Таблица товаров -->
                    <DataGrid x:Name="dgProducts" Grid.Row="1" AutoGenerateColumns="False" 
                              IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ProductID}" Width="50"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="150"/>
                            <DataGridTextColumn Header="Поставщик" Binding="{Binding SupplierName}" Width="150"/>
                            <DataGridTextColumn Header="Цена ($)" Binding="{Binding Price, StringFormat='${0:F2}'}" Width="100"/>
                            <DataGridTextColumn Header="Остаток" Binding="{Binding Stock}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Вкладка: Управление заказами -->
            <TabItem Header="Управление заказами" FontSize="14">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Кнопки управления заказами -->
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                        <Button Content="🗑 Удалить заказ" Width="140" Height="35" Margin="0,0,10,0"
                                Background="#F44336" Foreground="White" BorderThickness="0" 
                                Cursor="Hand" Click="btnDeleteOrder_Click"/>
                        <Button Content="🔄 Обновить список" Width="140" Height="35"
                                Background="#2196F3" Foreground="White" BorderThickness="0" 
                                Cursor="Hand" Click="btnRefreshOrders_Click"/>
                    </StackPanel>

                    <!-- Таблица заказов -->
                    <DataGrid x:Name="dgOrders" Grid.Row="1" AutoGenerateColumns="False" 
                              IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№ Заказа" Binding="{Binding OrderID}" Width="80"/>
                            <DataGridTextColumn Header="Клиент" Binding="{Binding CustomerName}" Width="*"/>
                            <DataGridTextColumn Header="Сотрудник" Binding="{Binding EmployeeName}" Width="*"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate, StringFormat='dd.MM.yyyy HH:mm'}" Width="150"/>
                            <DataGridTextColumn Header="Сумма ($)" Binding="{Binding TotalAmount, StringFormat='${0:F2}'}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
