<Window x:Class="FlowerShopWPF.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мир цветов" 
        Height="450" Width="450"
        MinHeight="450" MinWidth="400"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="CanResize" 
        Loaded="Window_Loaded">
    <Grid Background="#FFF5F5F5">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="20">
            <StackPanel MaxWidth="380">
                <TextBlock Text="Добавление товара" FontSize="20" FontWeight="Bold" 
                           Foreground="#FF8E8E" HorizontalAlignment="Center" Margin="0,10,0,20"/>

                <TextBlock Text="Название товара:" Margin="0,10,0,5" FontSize="13"/>
                <TextBox x:Name="txtName" Height="32" FontSize="13" Padding="5"/>

                <TextBlock Text="Категория:" Margin="0,10,0,5" FontSize="13"/>
                <ComboBox x:Name="cmbCategory" Height="32" FontSize="13" 
                          DisplayMemberPath="Name" SelectedValuePath="CategoryID"/>

                <TextBlock Text="Поставщик:" Margin="0,10,0,5" FontSize="13"/>
                <ComboBox x:Name="cmbSupplier" Height="32" FontSize="13" 
                          DisplayMemberPath="Name" SelectedValuePath="SupplierID"/>

                <TextBlock Text="Цена ($):" Margin="0,10,0,5" FontSize="13"/>
                <TextBox x:Name="txtPrice" Height="32" FontSize="13" Padding="5" 
                         ToolTip="Введите цену в долларах, например: 25.99"/>

                <TextBlock Text="Остаток (шт.):" Margin="0,10,0,5" FontSize="13"/>
                <TextBox x:Name="txtStock" Height="32" FontSize="13" Padding="5" Text="0"/>

                <Button Content="✔ Добавить" Height="40" Margin="0,25,0,0"
                        Background="#4CAF50" Foreground="White" 
                        FontSize="16" FontWeight="Bold" BorderThickness="0" 
                        Cursor="Hand" Click="btnAdd_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="5" Padding="5">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#45A049"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Отмена" Height="35" Margin="0,10,0,15"
                        Background="#CCCCCC" Foreground="#333" 
                        FontSize="14" BorderThickness="0" 
                        Cursor="Hand" Click="btnCancel_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="5" Padding="5">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#BBBBBB"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
