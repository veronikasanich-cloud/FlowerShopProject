<Window x:Class="FlowerShopWPF.CustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мир  цветов" 
        Height="650" Width="1000"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="CanResize"
        Loaded="Window_Loaded">
    <Grid Background="#FFF5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto" MinHeight="180"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#FF8E8E" Padding="20,0">
            <Grid>
                <TextBlock Text="🌺 Каталог Цветов" FontSize="24" FontWeight="Bold" 
                           Foreground="White" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="txtWelcome" FontSize="14" Foreground="White" 
                               VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Content="Выход" Width="80" Height="35" 
                            Background="#D32F2F" Foreground="White" 
                            BorderThickness="0" Cursor="Hand" Click="btnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Каталог товаров -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Доступные товары:" FontSize="16" FontWeight="Bold" 
                       Margin="0,0,0,10"/>

            <DataGrid x:Name="dgProducts" Grid.Row="1" AutoGenerateColumns="False" 
                      IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="150"/>
                    <DataGridTextColumn Header="Цена ($)" Binding="{Binding Price, StringFormat='${0:F2}'}" Width="100"/>
                    <DataGridTextColumn Header="В наличии" Binding="{Binding Stock}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Корзина -->
        <Border Grid.Row="2" Background="White" BorderBrush="#CCCCCC" 
                BorderThickness="1" Margin="15,0,15,15" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="🛒 Корзина:" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Количество:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="13"/>
                        <TextBox x:Name="txtQuantity" Width="70" Height="28" Text="1" 
                                 FontSize="13" VerticalContentAlignment="Center" Padding="5"/>
                        <Button Content="Добавить в корзину" Width="160" Height="32" Margin="15,0,0,0"
                                Background="#4CAF50" Foreground="White" BorderThickness="0" 
                                FontSize="13" FontWeight="Bold" Cursor="Hand" Click="btnAddToCart_Click"/>
                        <Button Content="🗑 Очистить корзину" Width="150" Height="32" Margin="10,0,0,0"
                                Background="#F44336" Foreground="White" BorderThickness="0" 
                                FontSize="13" Cursor="Hand" Click="btnClearCart_Click"/>
                    </StackPanel>

                    <ScrollViewer Height="70" VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="lstCart"/>
                    </ScrollViewer>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock x:Name="txtTotal" Text="Итого: $0.00" FontSize="18" 
                               FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    <Button Content="🛍 Оформить заказ" Height="50" 
                            Background="#FF8E8E" Foreground="White" FontSize="16" 
                            FontWeight="Bold" BorderThickness="0" 
                            Cursor="Hand" Click="btnCheckout_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5" Padding="5">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF7070"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
