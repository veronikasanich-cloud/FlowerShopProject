<Window x:Class="FlowerShopWPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мир цветов" 
        Height="420" Width="480"
        MinHeight="400" MinWidth="420"
        MaxHeight="500" MaxWidth="600"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="CanResize">
    <Grid Background="#FFF5F5F5">
        <Viewbox Stretch="Uniform" MaxWidth="380" MaxHeight="320">
            <Border Width="350" Height="352" Background="White" 
                    CornerRadius="10" Padding="25"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#CCCCCC" ShadowDepth="3" BlurRadius="10"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Мир цветов" FontSize="22" FontWeight="Bold" 
                               Foreground="#FF8E8E" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                    <TextBlock Text="Логин:" FontSize="13" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtLogin" Height="32" FontSize="13" Padding="5"/>

                    <TextBlock Text="Пароль:" FontSize="13" Margin="0,12,0,5"/>
                    <PasswordBox x:Name="txtPassword" Height="32" FontSize="13" Padding="5"/>

                    <Button x:Name="btnLogin" Content="Войти" Height="38" Margin="0,18,0,0"
                            Background="#4CAF50" Foreground="White" FontSize="15" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" Click="btnLogin_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5" Padding="5">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#45A049"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="btnRegister" Content="Регистрация" Height="33" Margin="0,8,0,0"
                            Background="#FF8E8E" Foreground="White" FontSize="13"
                            BorderThickness="0" Cursor="Hand" Click="btnRegister_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5" Padding="5">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF7070"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Viewbox>
    </Grid>
</Window>
